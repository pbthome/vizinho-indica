{
  "expo": {
    "name": "Vicini",
    "slug": "vizinho-indica",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vizinhoindica",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vicini.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ]
      }
    },
    "android": {
      "package": "com.vicini.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F6F5B"
      }
    },
    "plugins": [
      "expo-dev-client"
    ],
    "extra": {
      "eas": {
        "projectId": "a522708b-fb74-4298-800e-950961a956d0"
      }
    }
  }
}
